# Telegram bot token from @BotFather (required for delivery)
TELEGRAM_BOT_TOKEN=

# Optional. Leave blank to auto-detect from the latest message sent to your bot.
TELEGRAM_CHAT_ID=

# Polling interval in seconds (default 120)
POLL_SECONDS=120

# Stop monitoring after this many hours (default 24)
MAX_HOURS=24

# Surname prefix to extract (default G)
SURNAME_PREFIX=G
