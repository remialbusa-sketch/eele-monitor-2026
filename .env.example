# Telegram bot token from @BotFather (required for delivery)
TELEGRAM_BOT_TOKEN=

# Required for delivery. A private chat id (e.g. 123456789) or a group id, which is
# negative and must keep its leading minus (e.g. -1001234567890). Without the minus
# Telegram reads it as a user id and every send fails with "chat not found".
# Leave blank only to auto-detect from the latest message sent to your bot.
TELEGRAM_CHAT_ID=

# Polling interval in seconds (default 120; the GitHub live monitor uses 20)
POLL_SECONDS=20

# Telegram ping interval in seconds (default 600; the GitHub live monitor uses 300)
HEARTBEAT_SECONDS=300

# Force a full cache-busting fetch this often, in seconds (default 300)
FORCE_FETCH_SECONDS=300

# Stop monitoring after this many hours (default 24)
MAX_HOURS=24

# Surname prefix to extract (default G)
SURNAME_PREFIX=G
